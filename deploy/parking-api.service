[Unit]
Description=Parking API Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/parking_altea/src
Environment=PATH=/opt/parking_altea/venv/bin
ExecStart=/opt/parking_altea/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:6001 api_server:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target 